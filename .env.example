# Copiar a .env (cp .env.example .env). El .env no se versiona.
# No hay credenciales: Mongo corre sin autenticación y solo escucha en 127.0.0.1.

# Puerto de Mongo en la Mac
MONGO_PORT=27017

# Nombre de la base
MONGO_DB=ecommerce

# URI para scripts y notebook que corren EN LA MAC (cargar.py, análisis, pruebas).
# directConnection=true: el replica set anuncia su miembro como "mongo:27017", nombre
# que la Mac no resuelve. Con esto el driver habla directo con localhost sin descubrir miembros.
MONGO_URI=mongodb://localhost:27017/?directConnection=true

# La api DENTRO de Docker no usa MONGO_URI de acá: el compose le pasa
# mongodb://mongo:27017/?replicaSet=rs0 (nombre del servicio, no localhost).

# Puerto de la API en la Mac (Swagger en http://localhost:8000/docs)
API_PORT=8000
